        "def clean_text(s):\n",
        "    s = str(s).lower()\n",
        "    s = re.sub(r'<.*?>', ' ', s)\n",
        "    s = re.sub(r\"[^a-z']\", ' ', s)\n",
        "    s = re.sub(r'\\s+', ' ', s).strip()\n",
        "    return s\n",
        "\n",
        "# Display before cleaning\n",
        "print(\"BEFORE CLEANING:\")\n",
        "print(df['review'].iloc[0])\n",
        "\n",
        "# Apply cleaning\n",
        "df['review'] = df['review'].apply(clean_text)\n",
