      "source": [
        "### Task 43: Comparative Study Setup\n",
        "We verify model availability and prepare to run side-by-side evaluations."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import time\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import tensorflow as tf\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score,\n",
        "    roc_curve,\n",
        "    classification_report,\n",
        "    confusion_matrix\n",
        ")\n",
        "\n",
        "# Reproducibility\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "# Output directory\n",
        "os.makedirs('/content/plots', exist_ok=True)\n",
        "\n",
        "# Verify required objects\n",
        "required_objects = [\n",
        "    'X_train', 'X_test',\n",
        "    'y_train', 'y_test',\n",
        "    'MAXLEN', 'tokenizer',\n",
        "    'ann_model', 'rnn_model',\n",
        "    'lstm_model', 'stacked_lstm_model',\n",
        "    'gru_model', 'results'\n",
        "]\n",
        "\n",
        "for obj in required_objects:\n",
        "    assert obj in globals(), f\"Missing required object: {obj}\"\n",
        "\n",
        "print(\"All required models and datasets are available.\")\n",
        "print(\"Output Directory: /content/plots\")"
      ],
